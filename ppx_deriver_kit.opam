opam-version: "2.0"
maintainer: "Jane Street developers"
authors: ["Jane Street Group, LLC"]
homepage: "https://github.com/janestreet/ppx_deriver_kit"
bug-reports: "https://github.com/janestreet/ppx_deriver_kit/issues"
dev-repo: "git+https://github.com/janestreet/ppx_deriver_kit.git"
doc: "https://ocaml.janestreet.com/ocaml-core/latest/doc/ppx_deriver_kit/index.html"
license: "MIT"
x-maintenance-intent: ["(latest)"]
build: [
  ["dune" "build" "-p" name "-j" jobs]
]
depends: [
  "ocaml" {>= "5.1.0"}
  "ppx_helpers"
  "ppxlib_jane"
  "dune"        {>= "3.17.0"}
  "ppxlib"      {>= "0.39.0"}
]
available: arch != "x86_32"
synopsis: "Library to streamline writing new ppx derivers."
description: "

Provides a framework that does most of the boilerplate work of writing a new ppx deriver.
A ppx writer can define a series of callbacks to handle a given shape of type rather than
writing the full core type and type declaration recursion.
"
